			                COALESCE ( [@q], 0 ) = 0, "Sem compra 12M",
			                _Fim - [@u] > 60, "Em risco",
			                [@f] >= 10 && [@q] >= 1.2 * _Media, "Campeões",
			                [@f] >= 8 && [@q] >= 0.8 * _Media, "Leais",
			                "Ocasionais"
			            )
			    )
			VAR _Seg = SELECTEDVALUE ( Seg_RFQ[Segmento] )
			VAR _Sel = FILTER ( _S, ISBLANK ( _Seg ) || [@seg] = _Seg )
			RETURN DIVIDE ( SUMX ( _Sel, [@q] ), SUMX ( _S, [@q] ) ) + 0
		formatString: 0.0%
		displayFolder: 04 RFQ
		lineageTag: ede9621b-53c3-5de1-b50f-ad2e1811e5bf

	measure 'RFQ % Clientes' =
			VAR _Fim = MAX ( Dim_Calendario[Data] )
			VAR _Ini = EDATE ( _Fim, -12 ) + 1
			VAR _VendCtx =
			    CALCULATETABLE (
			        VALUES ( Dim_Vendedor[ID_Vendedor] ),
			        TREATAS ( VALUES ( Dim_Filial[ID_Filial] ), Dim_Vendedor[ID_Filial] )
			    )
			VAR _Clientes =
			    CALCULATETABLE ( VALUES ( Dim_Cliente[ID_Cliente] ), TREATAS ( _VendCtx, Dim_Cliente[ID_Vendedor] ) )
			VAR _Media =
			    CALCULATE (
			        AVERAGEX (
			            FILTER (
			                ADDCOLUMNS ( VALUES ( Dim_Cliente[ID_Cliente] ), "@q", [Quantidade] ),
			                [@q] > 0
			            ),
			            [@q]
			        ),
			        DATESBETWEEN ( Dim_Calendario[Data], _Ini, _Fim ),
			        REMOVEFILTERS ( Dim_Cliente ),
			        REMOVEFILTERS ( Dim_Municipio ),
			        REMOVEFILTERS ( Dim_Vendedor ),
			        REMOVEFILTERS ( Dim_Filial )
			    )
			VAR _T =
			    ADDCOLUMNS (
			        _Clientes,
			        "@q", CALCULATE ( [Quantidade], DATESBETWEEN ( Dim_Calendario[Data], _Ini, _Fim ) ),
			        "@v", CALCULATE ( [Faturamento], DATESBETWEEN ( Dim_Calendario[Data], _Ini, _Fim ) ),
			        "@f", CALCULATE (
			            DISTINCTCOUNT ( Fato_Vendas[Mes_Ref] ),
			            DATESBETWEEN ( Dim_Calendario[Data], _Ini, _Fim ),
			            Fato_Vendas[Tipo_Operacao] = "Venda"
			        ),
			        "@u", CALCULATE (
			            MAX ( Fato_Vendas[Data_Emissao] ),
			            REMOVEFILTERS ( Dim_Calendario ),
			            Dim_Calendario[Data] <= _Fim,
			            Fato_Vendas[Tipo_Operacao] = "Venda"
			        )
			    )
			VAR _S =
			    ADDCOLUMNS (
			        _T,
			        "@seg",
			            SWITCH (
			                TRUE (),
			                COALESCE ( [@q], 0 ) = 0, "Sem compra 12M",
			                _Fim - [@u] > 60, "Em risco",
			                [@f] >= 10 && [@q] >= 1.2 * _Media, "Campeões",
			                [@f] >= 8 && [@q] >= 0.8 * _Media, "Leais",
			                "Ocasionais"
			            )
			    )
			VAR _Seg = SELECTEDVALUE ( Seg_RFQ[Segmento] )
			VAR _Sel = FILTER ( _S, ISBLANK ( _Seg ) || [@seg] = _Seg )
			RETURN DIVIDE ( COUNTROWS ( _Sel ), COUNTROWS ( _S ) ) + 0
		formatString: 0.0%
		displayFolder: 04 RFQ
		lineageTag: f92260e5-608e-50fc-afd9-55f10314c322

	measure 'RFQ Ordem Segmento' = MIN ( Seg_RFQ[Ordem] )
		formatString: 0
		displayFolder: 04 RFQ
		lineageTag: 143dd6f9-9929-5915-b474-1ef7e38503ec

	measure 'Meses Equivalentes' =
			-- Fração de mês coberta pelo contexto (o mês corrente parcial conta pelos dias decorridos)
			SUMX (
			    VALUES ( Dim_Calendario[Inicio_Mes] ),
			    DIVIDE (
			        CALCULATE ( COUNTROWS ( Dim_Calendario ) ),
			        DAY ( EOMONTH ( Dim_Calendario[Inicio_Mes], 0 ) )
			    )
			)
		formatString: 0.00
		displayFolder: 05 Potencial e Share
		lineageTag: 2ddf4028-00d0-5ceb-bc15-572d4454134f

	measure 'Potencial Mensal' =
			-- Potencial é de mercado (município). Não se reparte por vendedor, filial, produto ou cliente.
			IF ( NOT ( ISFILTERED ( Dim_Vendedor ) || ISFILTERED ( Dim_Filial )
			    || ISFILTERED ( Dim_Produto ) || ISFILTERED ( Dim_Cliente ) ), SUM ( Dim_Municipio[Potencial_Baterias_Mes] ) )
		formatString: #,0
		displayFolder: 05 Potencial e Share
		lineageTag: 57fb6ba6-a7cd-5c40-b79e-3f3ac1ee4d74

	measure 'Potencial Período' = IF ( NOT ISBLANK ( [Potencial Mensal] ), [Potencial Mensal] * [Meses Equivalentes] )
		formatString: #,0
		displayFolder: 05 Potencial e Share
		lineageTag: bff2c109-a12c-5b70-bbf9-7cdc439566ad

	measure 'Share Potencial' = DIVIDE ( [Quantidade], [Potencial Período] )
		formatString: 0.0%
		displayFolder: 05 Potencial e Share
		lineageTag: f7cf1a58-b729-562d-b326-7d8371f342b0

	measure 'Share Potencial AA' =
			-- Mesmo recorte de dias, 12 meses antes. SAMEPERIODLASTYEAR estende até o fim do mês
			-- quando a seleção termina no último dia do calendário (data de corte) e infla o AA.
			VAR _Dias =
			    SELECTCOLUMNS ( VALUES ( Dim_Calendario[Data] ), "Data", EDATE ( Dim_Calendario[Data], -12 ) )
			RETURN
			    CALCULATE ( [Share Potencial], REMOVEFILTERS ( Dim_Calendario ), TREATAS ( _Dias, Dim_Calendario[Data] ) )
		formatString: 0.0%
		displayFolder: 05 Potencial e Share
		lineageTag: 5c13c8ff-20b0-57d7-b589-c95cda66f8ab

	measure 'Var Share p.p.' =
			VAR _aa = [Share Potencial AA]
			RETURN IF ( NOT ISBLANK ( _aa ) && NOT ISBLANK ( [Share Potencial] ), ( [Share Potencial] - _aa ) * 100 )
		formatString: +0.0;-0.0;0.0
		displayFolder: 05 Potencial e Share
		lineageTag: 051c470e-0365-505c-8caf-c650cd0aad8b

	measure 'Gap Potencial' =
			VAR _p = [Potencial Período]
			RETURN IF ( NOT ISBLANK ( _p ), MAX ( _p - [Quantidade], 0 ) )
		formatString: #,0
		displayFolder: 05 Potencial e Share
		lineageTag: 8e0aba6f-d90f-5df9-ab46-2407f6dc2d74

	measure 'Prospects Total' = COUNTROWS ( Fato_Prospects ) + 0
		formatString: #,0
		displayFolder: 05 Potencial e Share
		lineageTag: c99ba035-5e39-554e-a6f8-333d5f8fc7c3

	measure 'Prospects Liberados' = CALCULATE ( COUNTROWS ( Fato_Prospects ), KEEPFILTERS ( Fato_Prospects[Status_Prospect] = "Liberado" ) ) + 0
		formatString: #,0
		displayFolder: 05 Potencial e Share
		lineageTag: 4caf1565-048f-5450-861c-50f70ac13248

	measure 'Prospects Contatáveis' =
			-- Liberados para abordagem e com telefone cadastrado
			CALCULATE (
			    COUNTROWS ( Fato_Prospects ),
			    KEEPFILTERS ( Fato_Prospects[Status_Prospect] = "Liberado" ),
			    KEEPFILTERS ( Fato_Prospects[Possui_Telefone] = "Sim" )
			) + 0
		formatString: #,0
		displayFolder: 05 Potencial e Share
		lineageTag: 3c789210-994b-5eaa-a568-1f633b23821d

	measure 'Prospects Pendentes' = CALCULATE ( COUNTROWS ( Fato_Prospects ), KEEPFILTERS ( Fato_Prospects[Status_Prospect] = "Pendente Revisão" ) ) + 0
		formatString: #,0
		displayFolder: 05 Potencial e Share
