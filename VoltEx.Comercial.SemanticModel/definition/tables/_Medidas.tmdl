table _Medidas
	lineageTag: 74908720-150d-552d-acf6-07d07e29c566

	measure Quantidade =
			-- Regra do comercial: venda + bonificação. Troca em garantia fica fora.
			CALCULATE (
			    SUM ( Fato_Vendas[Quantidade] ),
			    KEEPFILTERS ( Fato_Vendas[Tipo_Operacao] IN { "Venda", "Bonificacao" } )
			)
		formatString: #,0
		displayFolder: 01 Vendas
		lineageTag: 9a6f15e1-97e3-59ed-947f-53badab0cf47

	measure 'Qtd Venda' = CALCULATE ( SUM ( Fato_Vendas[Quantidade] ), KEEPFILTERS ( Fato_Vendas[Tipo_Operacao] = "Venda" ) )
		formatString: #,0
		displayFolder: 01 Vendas
		lineageTag: 1e418fef-eb91-5e65-a1c4-ac692bbfb597

	measure 'Qtd Bonificação' = CALCULATE ( SUM ( Fato_Vendas[Quantidade] ), KEEPFILTERS ( Fato_Vendas[Tipo_Operacao] = "Bonificacao" ) )
		formatString: #,0
		displayFolder: 01 Vendas
		lineageTag: fac3f62b-9e67-5309-a682-19d47a2036b1

	measure 'Qtd Troca Garantia' = CALCULATE ( SUM ( Fato_Vendas[Quantidade] ), KEEPFILTERS ( Fato_Vendas[Tipo_Operacao] = "Troca Garantia" ) )
		formatString: #,0
		displayFolder: 01 Vendas
		lineageTag: 3f766d22-b0cd-5edd-955a-4b73af442481

	measure '% Garantia s/ Venda' = DIVIDE ( [Qtd Troca Garantia], [Qtd Venda] )
		formatString: 0.00%
		displayFolder: 01 Vendas
		lineageTag: b6400c37-3d57-5671-898c-feffb928cd55

	measure Faturamento =
			-- Bonificação e troca em garantia já vêm com faturamento zero da origem
			SUM ( Fato_Vendas[Faturamento_RS] )
		formatString: R$ #,0
		displayFolder: 01 Vendas
		lineageTag: b3f9b1fc-c79f-5cdf-a07c-86cba232e6b2

	measure 'Preço Médio' = DIVIDE ( [Faturamento], [Qtd Venda] )
		formatString: R$ #,0.00
		displayFolder: 01 Vendas
		lineageTag: 193dc664-f330-5fb8-89b7-35c681596729

	measure 'Itens de Nota' = CALCULATE ( COUNTROWS ( Fato_Vendas ), KEEPFILTERS ( Fato_Vendas[Tipo_Operacao] = "Venda" ) )
		formatString: #,0
		displayFolder: 01 Vendas
		lineageTag: 7a5ca50c-068c-5663-a76e-1c48a2210bdb

	measure 'Quantidade AA' =
			-- Mesmo recorte de dias, 12 meses antes. SAMEPERIODLASTYEAR estende até o fim do mês
			-- quando a seleção termina no último dia do calendário (data de corte) e infla o AA.
			VAR _Dias =
			    SELECTCOLUMNS ( VALUES ( Dim_Calendario[Data] ), "Data", EDATE ( Dim_Calendario[Data], -12 ) )
			RETURN
			    CALCULATE ( [Quantidade], REMOVEFILTERS ( Dim_Calendario ), TREATAS ( _Dias, Dim_Calendario[Data] ) )
		formatString: #,0
		displayFolder: 01 Vendas
		lineageTag: caffcc8e-0f70-561c-ab75-7e0e9a23ebaa

	measure 'Faturamento AA' =
			-- Mesmo recorte de dias, 12 meses antes. SAMEPERIODLASTYEAR estende até o fim do mês
			-- quando a seleção termina no último dia do calendário (data de corte) e infla o AA.
			VAR _Dias =
			    SELECTCOLUMNS ( VALUES ( Dim_Calendario[Data] ), "Data", EDATE ( Dim_Calendario[Data], -12 ) )
			RETURN
			    CALCULATE ( [Faturamento], REMOVEFILTERS ( Dim_Calendario ), TREATAS ( _Dias, Dim_Calendario[Data] ) )
		formatString: R$ #,0
		displayFolder: 01 Vendas
		lineageTag: 2d30b947-9a27-531c-8d56-cfe719b2d8f8

	measure 'Var % Qtd AA' =
			-- O calendário termina na data de corte, então "ano corrente" já é YTD
			-- e o AA compara o mesmo recorte de dias do ano anterior.
			VAR _AA = [Quantidade AA]
			RETURN IF ( NOT ISBLANK ( _AA ), DIVIDE ( [Quantidade] - _AA, _AA ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01 Vendas
		lineageTag: ffdec821-cb4b-5213-8c08-f36e795b04d2

	measure 'Var % Fat AA' =
			VAR _AA = [Faturamento AA]
			RETURN IF ( NOT ISBLANK ( _AA ), DIVIDE ( [Faturamento] - _AA, _AA ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01 Vendas
		lineageTag: 67b11323-b89b-580e-b073-424720dcf161

	measure 'Quantidade Mês Anterior' = CALCULATE ( [Quantidade], DATEADD ( Dim_Calendario[Data], -1, MONTH ) )
		formatString: #,0
		displayFolder: 01 Vendas
		lineageTag: 5fc521b2-19a2-54cc-938a-b691ce1c2a14

	measure '% Qtd s/ Total Produto' = DIVIDE ( [Quantidade], CALCULATE ( [Quantidade], ALLSELECTED ( Dim_Produto ) ) )
		formatString: 0.0%
		displayFolder: 01 Vendas
		lineageTag: 7fe77ffc-d6e2-51a1-803b-c33116380fd9

	measure '% Fat s/ Total Produto' = DIVIDE ( [Faturamento], CALCULATE ( [Faturamento], ALLSELECTED ( Dim_Produto ) ) )
		formatString: 0.0%
		displayFolder: 01 Vendas
		lineageTag: 5b97efc8-ce20-54cc-8749-07bf493b6929

	measure 'Data Corte' =
			-- Último dia carregado: Dim_Calendario vai até a data de corte (hoje)
			CALCULATE ( MAX ( Dim_Calendario[Data] ), REMOVEFILTERS ( Dim_Calendario ) )
		formatString: dd/mm/yyyy
		displayFolder: 01 Vendas
		lineageTag: c29bd2f2-3225-5ac9-a01e-a7f35f495b23

	measure 'Qtd Fora da UF da Filial' =
			-- Volume vendido a clientes de outro estado que não o da filial do vendedor
			SUMX (
			    FILTER (
			        Fato_Vendas,
			        Fato_Vendas[Tipo_Operacao] IN { "Venda", "Bonificacao" }
			            && RELATED ( Dim_Filial[UF_Filial] ) <> RELATED ( Dim_Municipio[UF] )
			    ),
			    Fato_Vendas[Quantidade]
			) + 0
		formatString: #,0
		displayFolder: 01 Vendas
		lineageTag: 420b65eb-77d4-5353-ae2a-74b1ae149126

	measure '% Qtd Fora da UF' = DIVIDE ( [Qtd Fora da UF da Filial], [Quantidade] )
		formatString: 0.0%
		displayFolder: 01 Vendas
		lineageTag: ed6a571f-c566-5c9d-8537-164aa029e33f

	measure 'Vendedores Abaixo 80%' =
			COUNTROWS (
			    FILTER ( VALUES ( Dim_Vendedor[ID_Vendedor] ), [% Atingimento Meta] < 0.8 )
			) + 0
		formatString: #,0
		displayFolder: 02 Metas
		lineageTag: 2e5bb453-9db3-56c2-8e2c-be60e67e9ad4

	measure 'Vendedores com Meta' =
			COUNTROWS (
			    FILTER ( VALUES ( Dim_Vendedor[ID_Vendedor] ), NOT ISBLANK ( [Meta Linha Leve] ) )
			) + 0
		formatString: #,0
		displayFolder: 02 Metas
		lineageTag: b8a3a072-b92b-599f-867e-edad9a7bf6fe

	measure 'Carteira Ativa' =
			-- Clientes com situação "Ativo" na carteira dos vendedores do contexto
			VAR _VendCtx =
			    CALCULATETABLE (
			        VALUES ( Dim_Vendedor[ID_Vendedor] ),
			        TREATAS ( VALUES ( Dim_Filial[ID_Filial] ), Dim_Vendedor[ID_Filial] )
			    )
			RETURN
			    CALCULATE (
			        COUNTROWS ( Dim_Cliente ),
			        KEEPFILTERS ( Dim_Cliente[Situacao] = "Ativo" ),
			        TREATAS ( _VendCtx, Dim_Cliente[ID_Vendedor] )
			    )
		formatString: #,0
		displayFolder: 03 Carteira e Cobertura
		lineageTag: 9989c656-0a97-54b9-8bc7-a67125defb03

	measure 'Clientes Positivados' =
			-- Clientes ativos com pelo menos uma venda no período
			CALCULATE (
			    DISTINCTCOUNT ( Fato_Vendas[ID_Cliente] ),
			    KEEPFILTERS ( Fato_Vendas[Tipo_Operacao] = "Venda" ),
			    KEEPFILTERS ( Dim_Cliente[Situacao] = "Ativo" )
			)
		formatString: #,0
		displayFolder: 03 Carteira e Cobertura
		lineageTag: 7292c423-1d65-5a31-9a9c-494921e4ad94

	measure '% Cobertura' =
			-- Positivação: ativos que compraram ÷ carteira ativa
			DIVIDE ( [Clientes Positivados], [Carteira Ativa] )
		formatString: 0.0%
		displayFolder: 03 Carteira e Cobertura
		lineageTag: a7f8df72-bd80-56c7-9641-6737b88ad468

	measure '% Cobertura AA' =
			-- Mesmo recorte de dias, 12 meses antes. SAMEPERIODLASTYEAR estende até o fim do mês
			-- quando a seleção termina no último dia do calendário (data de corte) e infla o AA.
			VAR _Dias =
			    SELECTCOLUMNS ( VALUES ( Dim_Calendario[Data] ), "Data", EDATE ( Dim_Calendario[Data], -12 ) )
			RETURN
			    CALCULATE ( [% Cobertura], REMOVEFILTERS ( Dim_Calendario ), TREATAS ( _Dias, Dim_Calendario[Data] ) )
		formatString: 0.0%
		displayFolder: 03 Carteira e Cobertura
		lineageTag: 588b19f9-0f89-51fd-8533-1c433f7a922f

	measure 'Clientes Compradores' = CALCULATE ( DISTINCTCOUNT ( Fato_Vendas[ID_Cliente] ), KEEPFILTERS ( Fato_Vendas[Tipo_Operacao] = "Venda" ) )
		formatString: #,0
		displayFolder: 03 Carteira e Cobertura
		lineageTag: cc7081a5-41ee-5332-b722-19ea3fe38f7d

	measure 'Ticket por Cliente' = DIVIDE ( [Faturamento], [Clientes Compradores] )
		formatString: R$ #,0
		displayFolder: 03 Carteira e Cobertura
		lineageTag: 02c92252-513d-57b4-8a23-94340876f15d

	measure 'Ticket por Cliente AA' =
			-- Mesmo recorte de dias, 12 meses antes. SAMEPERIODLASTYEAR estende até o fim do mês
			-- quando a seleção termina no último dia do calendário (data de corte) e infla o AA.
			VAR _Dias =
			    SELECTCOLUMNS ( VALUES ( Dim_Calendario[Data] ), "Data", EDATE ( Dim_Calendario[Data], -12 ) )
			RETURN
			    CALCULATE ( [Ticket por Cliente], REMOVEFILTERS ( Dim_Calendario ), TREATAS ( _Dias, Dim_Calendario[Data] ) )
		formatString: R$ #,0
		displayFolder: 03 Carteira e Cobertura
		lineageTag: 85701508-54d8-5dd5-8c52-2bd256e4e1b9

	measure 'Qtd Clientes Não Ativos' =
			-- Governança: volume faturado para cliente inativo ou bloqueado
			CALCULATE ( [Quantidade], KEEPFILTERS ( Dim_Cliente[Situacao] <> "Ativo" ) ) + 0
		formatString: #,0
		displayFolder: 03 Carteira e Cobertura
		lineageTag: 307ce524-3a7c-5fb0-b073-e7823a2e2709

	measure 'Clientes Não Ativos Comprando' =
			CALCULATE (
			    DISTINCTCOUNT ( Fato_Vendas[ID_Cliente] ),
			    KEEPFILTERS ( Fato_Vendas[Tipo_Operacao] = "Venda" ),
			    KEEPFILTERS ( Dim_Cliente[Situacao] <> "Ativo" )
			) + 0
		formatString: #,0
		displayFolder: 03 Carteira e Cobertura
		lineageTag: f98f706c-b2d0-5ad4-9626-6367709c729d

	measure 'Clientes Sem Compra 90d' =
			-- Ativos da carteira sem venda nos 90 dias até o fim do período
			VAR _Fim = MAX ( Dim_Calendario[Data] )
			VAR _VendCtx =
			    CALCULATETABLE (
			        VALUES ( Dim_Vendedor[ID_Vendedor] ),
			        TREATAS ( VALUES ( Dim_Filial[ID_Filial] ), Dim_Vendedor[ID_Filial] )
			    )
			VAR _Carteira =
			    CALCULATETABLE (
			        VALUES ( Dim_Cliente[ID_Cliente] ),
			        KEEPFILTERS ( Dim_Cliente[Situacao] = "Ativo" ),
			        TREATAS ( _VendCtx, Dim_Cliente[ID_Vendedor] )
			    )
			VAR _Compraram =
			    CALCULATETABLE (
			        VALUES ( Fato_Vendas[ID_Cliente] ),
			        DATESBETWEEN ( Dim_Calendario[Data], _Fim - 89, _Fim ),
			        Fato_Vendas[Tipo_Operacao] = "Venda"
			    )
			RETURN COUNTROWS ( EXCEPT ( _Carteira, _Compraram ) ) + 0
		formatString: #,0
		displayFolder: 03 Carteira e Cobertura
		lineageTag: 86298f1c-fb7d-56a0-bca0-abbb8dc469a9

	measure 'RFQ Clientes' =
			VAR _Fim = MAX ( Dim_Calendario[Data] )
			VAR _Ini = EDATE ( _Fim, -12 ) + 1
			VAR _VendCtx =
			    CALCULATETABLE (
			        VALUES ( Dim_Vendedor[ID_Vendedor] ),
			        TREATAS ( VALUES ( Dim_Filial[ID_Filial] ), Dim_Vendedor[ID_Filial] )
			    )
			VAR _Clientes =
			    CALCULATETABLE ( VALUES ( Dim_Cliente[ID_Cliente] ), TREATAS ( _VendCtx, Dim_Cliente[ID_Vendedor] ) )
			VAR _Media =
			    CALCULATE (
			        AVERAGEX (
			            FILTER (
			                ADDCOLUMNS ( VALUES ( Dim_Cliente[ID_Cliente] ), "@q", [Quantidade] ),
			                [@q] > 0
			            ),
			            [@q]
			        ),
			        DATESBETWEEN ( Dim_Calendario[Data], _Ini, _Fim ),
			        REMOVEFILTERS ( Dim_Cliente ),
			        REMOVEFILTERS ( Dim_Municipio ),
			        REMOVEFILTERS ( Dim_Vendedor ),
			        REMOVEFILTERS ( Dim_Filial )
			    )
			VAR _T =
			    ADDCOLUMNS (
			        _Clientes,
			        "@q", CALCULATE ( [Quantidade], DATESBETWEEN ( Dim_Calendario[Data], _Ini, _Fim ) ),
			        "@v", CALCULATE ( [Faturamento], DATESBETWEEN ( Dim_Calendario[Data], _Ini, _Fim ) ),
			        "@f", CALCULATE (
			            DISTINCTCOUNT ( Fato_Vendas[Mes_Ref] ),
			            DATESBETWEEN ( Dim_Calendario[Data], _Ini, _Fim ),
			            Fato_Vendas[Tipo_Operacao] = "Venda"
			        ),
			        "@u", CALCULATE (
			            MAX ( Fato_Vendas[Data_Emissao] ),
			            REMOVEFILTERS ( Dim_Calendario ),
			            Dim_Calendario[Data] <= _Fim,
			            Fato_Vendas[Tipo_Operacao] = "Venda"
			        )
			    )
			VAR _S =
			    ADDCOLUMNS (
			        _T,
			        "@seg",
			            SWITCH (
			                TRUE (),
			                COALESCE ( [@q], 0 ) = 0, "Sem compra 12M",
			                _Fim - [@u] > 60, "Em risco",
			                [@f] >= 10 && [@q] >= 1.2 * _Media, "Campeões",
			                [@f] >= 8 && [@q] >= 0.8 * _Media, "Leais",
			                "Ocasionais"
			            )
			    )
			VAR _Seg = SELECTEDVALUE ( Seg_RFQ[Segmento] )
			VAR _Sel = FILTER ( _S, ISBLANK ( _Seg ) || [@seg] = _Seg )
			RETURN COUNTROWS ( _Sel ) + 0
		formatString: #,0
		displayFolder: 04 RFQ
		lineageTag: 23ba76e7-dbb2-5fea-a473-7be4a2c29e81

	measure 'RFQ Qtd 12M' =
