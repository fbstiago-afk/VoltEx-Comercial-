			    & IF ( [Qtd Filtros Ativos] = 0, "Nenhum filtro ativo", [Qtd Filtros Ativos] & " filtro(s) ativo(s)" )
			    & "</div><div class='chips' style='justify-content:flex-start;margin-top:8px;max-width:100%'>" & [Trilha Filtros HTML] & "</div></div>"
