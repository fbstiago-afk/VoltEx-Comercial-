	measure 'Qtd Filtros Ativos' =
			ISFILTERED ( Dim_Calendario[Ano] ) + ISFILTERED ( Dim_Filial[Filial_Curta] )
			    + ISFILTERED ( Dim_Vendedor[Nome_Vendedor] ) + ISFILTERED ( Dim_Produto[Linha] )
			    + ISFILTERED ( Dim_Cliente[Ramo_Atividade] ) + ISFILTERED ( Dim_Municipio[Municipio] )
		formatString: 0
		displayFolder: 91 HTML
		lineageTag: 0a6e88b7-b795-5a0e-abe1-9bed898f054f

	measure 'Trilha Filtros HTML' =
			VAR _Ch = "<span class='chip'>"
			VAR _Fe = "</span>"
			VAR _Chips =
			    IF ( ISFILTERED ( Dim_Calendario[Ano] ),
			        VAR _n = COUNTROWS ( VALUES ( Dim_Calendario[Ano] ) )
			        RETURN _Ch & "Ano · "
			            & IF ( _n > 3, _n & " selecionados", CONCATENATEX ( VALUES ( Dim_Calendario[Ano] ), Dim_Calendario[Ano], ", ", Dim_Calendario[Ano], ASC ) )
			            & _Fe )
			    & IF ( ISFILTERED ( Dim_Filial[Filial_Curta] ),
			        VAR _n = COUNTROWS ( VALUES ( Dim_Filial[Filial_Curta] ) )
			        RETURN _Ch & "Filial · "
			            & IF ( _n > 3, _n & " selecionados", CONCATENATEX ( VALUES ( Dim_Filial[Filial_Curta] ), Dim_Filial[Filial_Curta], ", ", Dim_Filial[Filial_Curta], ASC ) )
			            & _Fe )
			    & IF ( ISFILTERED ( Dim_Vendedor[Nome_Vendedor] ),
			        VAR _n = COUNTROWS ( VALUES ( Dim_Vendedor[Nome_Vendedor] ) )
			        RETURN _Ch & "Vendedor · "
			            & IF ( _n > 2, _n & " selecionados", CONCATENATEX ( VALUES ( Dim_Vendedor[Nome_Vendedor] ), Dim_Vendedor[Nome_Vendedor], ", ", Dim_Vendedor[Nome_Vendedor], ASC ) )
			            & _Fe )
			    & IF ( ISFILTERED ( Dim_Produto[Linha] ),
			        VAR _n = COUNTROWS ( VALUES ( Dim_Produto[Linha] ) )
			        RETURN _Ch & "Linha · "
			            & IF ( _n > 3, _n & " selecionados", CONCATENATEX ( VALUES ( Dim_Produto[Linha] ), Dim_Produto[Linha], ", ", Dim_Produto[Linha], ASC ) )
			            & _Fe )
			    & IF ( ISFILTERED ( Dim_Cliente[Ramo_Atividade] ),
			        VAR _n = COUNTROWS ( VALUES ( Dim_Cliente[Ramo_Atividade] ) )
			        RETURN _Ch & "Ramo · "
			            & IF ( _n > 2, _n & " selecionados", CONCATENATEX ( VALUES ( Dim_Cliente[Ramo_Atividade] ), Dim_Cliente[Ramo_Atividade], ", ", Dim_Cliente[Ramo_Atividade], ASC ) )
			            & _Fe )
			    & IF ( ISFILTERED ( Dim_Municipio[Municipio] ),
			        VAR _n = COUNTROWS ( VALUES ( Dim_Municipio[Municipio] ) )
			        RETURN _Ch & "Município · "
			            & IF ( _n > 2, _n & " selecionados", CONCATENATEX ( VALUES ( Dim_Municipio[Municipio] ), Dim_Municipio[Municipio], ", ", Dim_Municipio[Municipio], ASC ) )
			            & _Fe )
			VAR _Per =
			    "<span class='per'>" & FORMAT ( MIN ( Dim_Calendario[Data] ), "dd/mm/yy" ) & " – "
			        & FORMAT ( MAX ( Dim_Calendario[Data] ), "dd/mm/yy" ) & "</span>"
			RETURN
			    _Per & IF ( _Chips = "", "<span class='per'>· visão consolidada, sem filtros</span>", _Chips )
		displayFolder: 91 HTML
		lineageTag: c8050f82-cbb4-565a-9684-cc44a27a1398

