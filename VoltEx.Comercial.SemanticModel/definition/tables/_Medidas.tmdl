			                _Fim - [@u] > 60, "Em risco",
			                [@f] >= 10 && [@q] >= 1.2 * _Media, "Campeões",
			                [@f] >= 8 && [@q] >= 0.8 * _Media, "Leais",
			                "Ocasionais"
			            )
			    )
			VAR _Seg = SELECTEDVALUE ( Seg_RFQ[Segmento] )
			VAR _Sel = FILTER ( _S, ISBLANK ( _Seg ) || [@seg] = _Seg )
			RETURN SUMX ( _Sel, [@q] ) + 0
		formatString: #,0
		displayFolder: 04 RFQ
		lineageTag: c5e647f9-3ca5-5c96-a826-c4b5c66c9057

