	measure 'KPI Visao' =
			VAR _vq = [Var % Qtd AA]
			VAR _vf = [Var % Fat AA]
			VAR _sh = [Share Potencial]
			VAR _pp = [Var Share p.p.]
			VAR _at = [% Atingimento Meta]
			VAR _td = [% Tendência Meta]
			RETURN
			"<div class='vx kb k6' style='height:78px'>" & "<div class='k'><div class='kl'>Quantidade</div><div class='kv'>" & FORMAT ( [Quantidade], "#,0" ) & "<small>un</small>" & "</div><div class='ks'>" & IF ( ISBLANK ( _vq ), "<span class='mut'>sem base no ano anterior</span>", "<span class='" & IF ( _vq >= 0, "up", "dn" ) & "'>" & IF ( _vq >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _vq ), "0.0%" ) & "</span> vs mesmo período AA" ) & "</div></div>" & "<div class='k'><div class='kl'>Faturamento</div><div class='kv'>" & "R$ " & FORMAT ( [Faturamento] / 1000000, "#,0.0" ) & "<small>mi</small>" & "</div><div class='ks'>" & IF ( ISBLANK ( _vf ), "<span class='mut'>sem base no ano anterior</span>", "<span class='" & IF ( _vf >= 0, "up", "dn" ) & "'>" & IF ( _vf >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _vf ), "0.0%" ) & "</span> vs mesmo período AA" ) & "</div></div>" & "<div class='k'><div class='kl'>Cobertura</div><div class='kv'>" & FORMAT ( [% Cobertura], "0.0%" ) & "</div><div class='ks'>" & FORMAT ( [Clientes Positivados], "#,0" ) & " de " & FORMAT ( [Carteira Ativa], "#,0" ) & " ativos compraram" & "</div></div>" & "<div class='k'><div class='kl'>Ticket por cliente</div><div class='kv'>" & "R$ " & FORMAT ( [Ticket por Cliente] / 1000, "#,0.0" ) & "<small>mil</small>" & "</div><div class='ks'>" & "preço médio R$ " & FORMAT ( [Preço Médio], "#,0" ) & "/un" & "</div></div>" & "<div class='k'><div class='kl'>Share do potencial</div><div class='kv'>" & IF ( ISBLANK ( _sh ), "—", FORMAT ( _sh, "0.0%" ) ) & "</div><div class='ks'>" & IF ( ISBLANK ( _sh ), "<span class='mut'>potencial é por município</span>", IF ( ISBLANK ( _pp ), "gap de " & FORMAT ( [Gap Potencial] / 1000, "#,0" ) & " mil un", "<span class='" & IF ( _pp >= 0, "up", "dn" ) & "'>" & FORMAT ( _pp, "+0.0;-0.0" ) & " p.p.</span> vs AA" ) ) & "</div></div>" & "<div class='k'><div class='kl'>Meta Linha Leve</div><div class='kv'>" & IF ( ISBLANK ( _at ), "—", FORMAT ( _at, "0%" ) ) & "</div><div class='ks'>" & IF ( ISBLANK ( _at ), "<span class='mut'>meta indisponível neste filtro</span>", "tendência <span class='" & IF ( _td >= 1, "up", IF ( _td >= 0.8, "wa", "dn" ) ) & "'>" & FORMAT ( _td, "0%" ) & "</span>" ) & "</div></div>" & "</div>"
		displayFolder: 91 HTML
		lineageTag: a4ed609a-b44d-5990-92e5-eda9b161ee03

	measure 'Insight Visao' =
			VAR _Corte = [Data Corte]
			VAR _Parcial = DAY ( _Corte ) < DAY ( EOMONTH ( _Corte, 0 ) )
			VAR _MesTxt = FORMAT ( _Corte, "mmmm" )
			VAR _vq = [Var % Qtd AA]
			VAR _Frase =
			    "<b>" & FORMAT ( [Quantidade], "#,0" ) & "</b> baterias no período"
			        & IF ( ISBLANK ( _vq ), "", ", <b>" & FORMAT ( _vq, "+0.0%;-0.0%" ) & "</b> contra o mesmo recorte do ano anterior" )
			        & ". A Linha Leve responde por <b>" & FORMAT ( [% Linha Leve no Volume], "0%" ) & "</b> do volume."
			        & IF ( _Parcial, " " & UPPER ( LEFT ( _MesTxt, 1 ) ) & MID ( _MesTxt, 2, 20 ) & " é parcial (" & DAY ( _Corte ) & " de " & DAY ( EOMONTH ( _Corte, 0 ) ) & " dias) e aparece destacado no gráfico.", "" )
			RETURN
			    "<div class='vx ins' style='height:48px'><span class='dot'></span><div>" & _Frase & "</div>" & "<span class='src'>Fonte: base comercial VoltEx · corte em " & FORMAT ( [Data Corte], "dd/mm/yyyy" ) & "</span>" & "</div>"
		displayFolder: 91 HTML
		lineageTag: ac21ab3d-1de9-583c-ac70-0e343ad549a6

	measure 'KPI Metas' =
			VAR _at = [% Atingimento Meta]
			VAR _td = [% Tendência Meta]
			VAR _vh = CALCULATE ( [Var % Qtd AA], KEEPFILTERS ( Dim_Produto[Familia] = "Linha Leve" ) )
			RETURN
			"<div class='vx kb ' style='height:78px'>" & "<div class='k'><div class='kl'>Vendas Linha Leve</div><div class='kv'>" & FORMAT ( [Qtd Linha Leve], "#,0" ) & "<small>un</small>" & "</div><div class='ks'>" & IF ( ISBLANK ( _vh ), "<span class='mut'>sem base no ano anterior</span>", "<span class='" & IF ( _vh >= 0, "up", "dn" ) & "'>" & IF ( _vh >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _vh ), "0.0%" ) & "</span> vs mesmo período AA" ) & "</div></div>" & "<div class='k'><div class='kl'>Meta Linha Leve</div><div class='kv'>" & IF ( ISBLANK ( [Meta Linha Leve] ), "—", FORMAT ( [Meta Linha Leve], "#,0" ) & "<small>un</small>" ) & "</div><div class='ks'>" & IF ( ISBLANK ( [Meta Linha Leve] ), "<span class='mut'>sem meta neste filtro</span>", "gap de " & FORMAT ( [Gap Meta], "#,0" ) & " un" ) & "</div></div>" & "<div class='k'><div class='kl'>Atingimento</div><div class='kv'>" & IF ( ISBLANK ( _at ), "—", "<span class='" & IF ( _at >= 1, "up", IF ( _at >= 0.8, "", "dn" ) ) & "'>" & FORMAT ( _at, "0.0%" ) & "</span>" ) & "</div><div class='ks'>" & "realizado ÷ meta do período" & "</div></div>" & "<div class='k'><div class='kl'>Tendência</div><div class='kv'>" & IF ( ISBLANK ( _td ), "—", FORMAT ( _td, "0.0%" ) ) & "</div><div class='ks'>" & "mês corrente projetado até o fim" & "</div></div>" & "<div class='k'><div class='kl'>Abaixo de 80%</div><div class='kv'>" & FORMAT ( [Vendedores Abaixo 80%], "0" ) & "<small>de " & FORMAT ( [Vendedores com Meta], "0" ) & "</small>" & "</div><div class='ks'>" & "vendedores" & "</div></div>" & "</div>"
		displayFolder: 91 HTML
		lineageTag: feb49135-0b12-52a2-b2de-6d303cbb5c7b

	measure 'Insight Metas' =
			VAR _T =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( Dim_Vendedor[Nome_Vendedor] ), "@at", [% Atingimento Meta] ),
			        NOT ISBLANK ( [@at] )
			    )
			VAR _Pior = TOPN ( 1, _T, [@at], ASC )
			VAR _Frase =
			    IF (
			        ISEMPTY ( _T ),
			        "Meta Linha Leve indisponível neste filtro: ela existe só no grão vendedor × mês.",
			        "<b>" & [Vendedores Abaixo 80%] & " de " & [Vendedores com Meta] & "</b> vendedores abaixo de 80% da meta da Linha Leve; o menor atingimento é <b>"
			            & MAXX ( _Pior, Dim_Vendedor[Nome_Vendedor] ) & "</b> (" & FORMAT ( MAXX ( _Pior, [@at] ), "0%" ) & "). "
			            & "<b>" & FORMAT ( [% Qtd Fora da UF], "0%" ) & "</b> do volume vai para clientes fora do estado da filial do vendedor: território e filial não se sobrepõem."
			    )
			RETURN
			    "<div class='vx ins' style='height:48px'><span class='dot'></span><div>" & _Frase & "</div>" & "<span class='src'>Fonte: base comercial VoltEx · corte em " & FORMAT ( [Data Corte], "dd/mm/yyyy" ) & "</span>" & "</div>"
		displayFolder: 91 HTML
		lineageTag: 905d5f4c-9558-55d4-938f-62783bb67633

	measure 'KPI Carteira' =
			VAR _cob = [% Cobertura]
			VAR _aa = [% Cobertura AA]
			VAR _pp = ( _cob - _aa ) * 100
			RETURN
			"<div class='vx kb ' style='height:78px'>" & "<div class='k'><div class='kl'>Carteira ativa</div><div class='kv'>" & FORMAT ( [Carteira Ativa], "#,0" ) & "<small>clientes</small>" & "</div><div class='ks'>" & FORMAT ( [Clientes Sem Compra 90d], "0" ) & " sem compra em 90 dias" & "</div></div>" & "<div class='k'><div class='kl'>Positivados</div><div class='kv'>" & FORMAT ( [Clientes Positivados], "#,0" ) & "</div><div class='ks'>" & "ativos com venda no período" & "</div></div>" & "<div class='k'><div class='kl'>Cobertura</div><div class='kv'>" & FORMAT ( _cob, "0.0%" ) & "</div><div class='ks'>" & IF ( ISBLANK ( _aa ), "<span class='mut'>sem base no ano anterior</span>", "<span class='" & IF ( _pp >= 0, "up", "dn" ) & "'>" & FORMAT ( _pp, "+0.0;-0.0;0.0" ) & " p.p.</span> vs AA" ) & "</div></div>" & "<div class='k'><div class='kl'>Ticket por cliente</div><div class='kv'>" & "R$ " & FORMAT ( [Ticket por Cliente] / 1000, "#,0.0" ) & "<small>mil</small>" & "</div><div class='ks'>" & FORMAT ( DIVIDE ( [Quantidade], [Clientes Compradores] ), "#,0" ) & " un por cliente" & "</div></div>" & "<div class='k'><div class='kl'>Inativos comprando</div><div class='kv'>" & "<span class='" & IF ( [Clientes Não Ativos Comprando] > 0, "wa", "" ) & "'>" & FORMAT ( [Clientes Não Ativos Comprando], "0" ) & "</span><small>clientes</small>" & "</div><div class='ks'>" & FORMAT ( [Qtd Clientes Não Ativos], "#,0" ) & " un para inativo/bloqueado" & "</div></div>" & "</div>"
		displayFolder: 91 HTML
		lineageTag: e87d2532-cdf3-5f92-8bf9-a92f76112abd

	measure 'Insight Carteira' =
			VAR _Seg = TREATAS ( { "Campeões" }, Seg_RFQ[Segmento] )
			VAR _nC = CALCULATE ( [RFQ Clientes], _Seg )
			VAR _pC = CALCULATE ( [RFQ % Qtd 12M], _Seg )
			VAR _nR = CALCULATE ( [RFQ Clientes], TREATAS ( { "Em risco" }, Seg_RFQ[Segmento] ) )
			VAR _Frase =
			    "<b>" & _nC & " clientes Campeões</b> compram " & FORMAT ( _pC, "0%" ) & " do volume dos últimos 12 meses"
			        & IF ( _nR > 0, "; <b>" & _nR & "</b> " & IF ( _nR = 1, "está", "estão" ) & " em risco (sem compra há mais de 60 dias)", "; nenhum cliente em risco" ) & ". "
			        & IF ( [Clientes Não Ativos Comprando] > 0,
			            "<b>" & [Clientes Não Ativos Comprando] & " clientes inativos ou bloqueados</b> seguem comprando: revisar cadastro e crédito.",
			            "Nenhuma venda para cliente inativo ou bloqueado." )
			RETURN
			    "<div class='vx ins' style='height:48px'><span class='dot'></span><div>" & _Frase & "</div>" & "<span class='src'>Fonte: base comercial VoltEx · corte em " & FORMAT ( [Data Corte], "dd/mm/yyyy" ) & "</span>" & "</div>"
		displayFolder: 91 HTML
		lineageTag: 1c285f53-45d1-5572-8d7a-32a35bc11ca2

	measure 'KPI Mercado' =
			VAR _sh = [Share Potencial]
			VAR _pp = [Var Share p.p.]
			RETURN
			"<div class='vx kb ' style='height:78px'>" & "<div class='k'><div class='kl'>Potencial do período</div><div class='kv'>" & IF ( ISBLANK ( [Potencial Período] ), "—", FORMAT ( [Potencial Período] / 1000, "#,0.0" ) & "<small>mil</small>" ) & "</div><div class='ks'>" & IF ( ISBLANK ( [Potencial Período] ), "<span class='mut'>limpe vendedor, filial, linha e ramo</span>", FORMAT ( [Meses Equivalentes], "0.0" ) & " meses de mercado" ) & "</div></div>" & "<div class='k'><div class='kl'>Vendido</div><div class='kv'>" & FORMAT ( [Quantidade] / 1000, "#,0.0" ) & "<small>mil</small>" & "</div><div class='ks'>" & "baterias, venda + bonificação" & "</div></div>" & "<div class='k'><div class='kl'>Share</div><div class='kv'>" & IF ( ISBLANK ( _sh ), "—", FORMAT ( _sh, "0.0%" ) ) & "</div><div class='ks'>" & IF ( ISBLANK ( _pp ), "<span class='mut'>sem base no ano anterior</span>", "<span class='" & IF ( _pp >= 0, "up", "dn" ) & "'>" & FORMAT ( _pp, "+0.0;-0.0;0.0" ) & " p.p.</span> vs AA" ) & "</div></div>" & "<div class='k'><div class='kl'>Gap não capturado</div><div class='kv'>" & IF ( ISBLANK ( [Gap Potencial] ), "—", FORMAT ( [Gap Potencial] / 1000, "#,0.0" ) & "<small>mil</small>" ) & "</div><div class='ks'>" & "baterias compradas da concorrência" & "</div></div>" & "<div class='k'><div class='kl'>Prospects contatáveis</div><div class='kv'>" & FORMAT ( [Prospects Contatáveis], "#,0" ) & "</div><div class='ks'>" & FORMAT ( [Prospects Pendentes], "#,0" ) & " pendentes de revisão" & "</div></div>" & "</div>"
		displayFolder: 91 HTML
		lineageTag: d2ce31df-0bc0-5571-885d-9cfe9eef3fab

	measure 'Insight Mercado' =
			VAR _T =
			    ADDCOLUMNS (
			        VALUES ( Dim_Municipio[Municipio] ),
			        "@pot", CALCULATE ( SUM ( Dim_Municipio[Potencial_Baterias_Mes] ) ),
			        "@sh", [Share Potencial],
			        "@gap", [Gap Potencial],
			        "@pr", [Prospects Contatáveis]
			    )
			VAR _TotPot = SUMX ( _T, [@pot] )
			VAR _Big = TOPN ( 1, _T, [@gap], DESC )
			VAR _Frase =
			    IF (
			        ISBLANK ( [Potencial Período] ),
			        "O potencial é de mercado, por município: com filtro de vendedor, filial, linha ou ramo o share não tem denominador válido.",
			        "<b>" & MAXX ( _Big, Dim_Municipio[Municipio] ) & "</b> concentra <b>" & FORMAT ( DIVIDE ( MAXX ( _Big, [@pot] ), _TotPot ), "0%" )
			            & "</b> do potencial com share de <b>" & FORMAT ( MAXX ( _Big, [@sh] ), "0.0%" ) & "</b>: <b>"
			            & FORMAT ( MAXX ( _Big, [@gap] ) / 1000, "#,0" ) & " mil</b> baterias não capturadas e <b>"
			            & FORMAT ( MAXX ( _Big, [@pr] ), "#,0" ) & "</b> prospects liberados com telefone na praça."
			    )
			RETURN
			    "<div class='vx ins' style='height:48px'><span class='dot'></span><div>" & _Frase & "</div>" & "<span class='src'>Fonte: base comercial VoltEx · corte em " & FORMAT ( [Data Corte], "dd/mm/yyyy" ) & "</span>" & "</div>"
		displayFolder: 91 HTML
		lineageTag: 9174287e-afeb-5c4a-b795-dc3977fe89b1

	measure 'KPI SWOT' = "<div class='vx kb ' style='height:78px'>" & "<div class='k'><div class='kl'><span class='up'>●</span> Fortalezas</div><div class='kv'>" & FORMAT ( CALCULATE ( [SWOT Clientes], TREATAS ( { "Fortalezas" }, Seg_SWOT[Quadrante] ) ), "0" ) & "<small>clientes</small>" & "</div><div class='ks'>" & FORMAT ( CALCULATE ( [SWOT % Qtd], TREATAS ( { "Fortalezas" }, Seg_SWOT[Quadrante] ) ), "0%" ) & " do volume · " & IF ( ISBLANK ( CALCULATE ( [SWOT Var Qtd], TREATAS ( { "Fortalezas" }, Seg_SWOT[Quadrante] ) ) ), "sem AA", FORMAT ( CALCULATE ( [SWOT Var Qtd], TREATAS ( { "Fortalezas" }, Seg_SWOT[Quadrante] ) ), "+0%;-0%" ) & " vs AA" ) & "</div></div>" & "<div class='k'><div class='kl'><span class='wa'>●</span> Atenção</div><div class='kv'>" & FORMAT ( CALCULATE ( [SWOT Clientes], TREATAS ( { "Atenção" }, Seg_SWOT[Quadrante] ) ), "0" ) & "<small>clientes</small>" & "</div><div class='ks'>" & FORMAT ( CALCULATE ( [SWOT % Qtd], TREATAS ( { "Atenção" }, Seg_SWOT[Quadrante] ) ), "0%" ) & " do volume · " & IF ( ISBLANK ( CALCULATE ( [SWOT Var Qtd], TREATAS ( { "Atenção" }, Seg_SWOT[Quadrante] ) ) ), "sem AA", FORMAT ( CALCULATE ( [SWOT Var Qtd], TREATAS ( { "Atenção" }, Seg_SWOT[Quadrante] ) ), "+0%;-0%" ) & " vs AA" ) & "</div></div>" & "<div class='k'><div class='kl'><span class='bl'>●</span> Oportunidades</div><div class='kv'>" & FORMAT ( CALCULATE ( [SWOT Clientes], TREATAS ( { "Oportunidades" }, Seg_SWOT[Quadrante] ) ), "0" ) & "<small>clientes</small>" & "</div><div class='ks'>" & FORMAT ( CALCULATE ( [SWOT % Qtd], TREATAS ( { "Oportunidades" }, Seg_SWOT[Quadrante] ) ), "0%" ) & " do volume · " & IF ( ISBLANK ( CALCULATE ( [SWOT Var Qtd], TREATAS ( { "Oportunidades" }, Seg_SWOT[Quadrante] ) ) ), "sem AA", FORMAT ( CALCULATE ( [SWOT Var Qtd], TREATAS ( { "Oportunidades" }, Seg_SWOT[Quadrante] ) ), "+0%;-0%" ) & " vs AA" ) & "</div></div>" & "<div class='k'><div class='kl'><span class='dn'>●</span> Fraquezas</div><div class='kv'>" & FORMAT ( CALCULATE ( [SWOT Clientes], TREATAS ( { "Fraquezas" }, Seg_SWOT[Quadrante] ) ), "0" ) & "<small>clientes</small>" & "</div><div class='ks'>" & FORMAT ( CALCULATE ( [SWOT % Qtd], TREATAS ( { "Fraquezas" }, Seg_SWOT[Quadrante] ) ), "0%" ) & " do volume · " & IF ( ISBLANK ( CALCULATE ( [SWOT Var Qtd], TREATAS ( { "Fraquezas" }, Seg_SWOT[Quadrante] ) ) ), "sem AA", FORMAT ( CALCULATE ( [SWOT Var Qtd], TREATAS ( { "Fraquezas" }, Seg_SWOT[Quadrante] ) ), "+0%;-0%" ) & " vs AA" ) & "</div></div>" & "<div class='k'><div class='kl'>Linha de corte</div><div class='kv'>" & FORMAT ( [Média Qtd por Cliente], "#,0" ) & "<small>un</small>" & "</div><div class='ks'>" & "média por cliente no período" & "</div></div>" & "</div>"
		displayFolder: 91 HTML
		lineageTag: 3573be2d-fb65-5633-b813-a44b5d4aaaa8

	measure 'Insight SWOT' =
			VAR _A = TREATAS ( { "Atenção" }, Seg_SWOT[Quadrante] )
			VAR _O = TREATAS ( { "Oportunidades" }, Seg_SWOT[Quadrante] )
			VAR _Frase =
			    IF (
			        ISBLANK ( [Quantidade AA] ),
			        "Sem base no ano anterior para este recorte: todo cliente aparece como crescendo. Selecione um ano com histórico.",
			        "<b>" & CALCULATE ( [SWOT Clientes], _A ) & " clientes grandes estão encolhendo</b> (Atenção) e somam <b>"
			            & FORMAT ( CALCULATE ( [SWOT % Qtd], _A ), "0%" ) & "</b> do volume: é a lista de visita desta semana. "
			            & CALCULATE ( [SWOT Clientes], _O ) & " clientes pequenos crescendo formam a fila de desenvolvimento."
			    )
			RETURN
			    "<div class='vx ins' style='height:48px'><span class='dot'></span><div>" & _Frase & "</div>" & "<span class='src'>Fonte: base comercial VoltEx · corte em " & FORMAT ( [Data Corte], "dd/mm/yyyy" ) & "</span>" & "</div>"
		displayFolder: 91 HTML
		lineageTag: bdd6fc9a-9785-56cb-b6ed-7498773b023b

	measure 'Catalogo Linhas HTML' =
			VAR _Card =
			    CONCATENATEX (
			        VALUES ( Dim_Produto[Linha] ),
			        VAR _img = CALCULATE ( MAX ( Dim_Produto[Imagem_Linha] ) )
			        VAR _sh = [% Qtd s/ Total Produto]
			        VAR _v = [Var % Qtd AA]
			        RETURN
			            "<div class='pc'><img src='" & _img & "'/><div><div class='pn'>" & Dim_Produto[Linha] & "</div><div class='pv'>"
			                & FORMAT ( _sh, "0.0%" ) & "<small>do volume</small></div><div class='ks'>"
			                & IF ( ISBLANK ( _v ), "R$ " & FORMAT ( [Preço Médio], "#,0" ) & "/un",
			                    "<span class='" & IF ( _v >= 0, "up", "dn" ) & "'>" & FORMAT ( _v, "+0.0%;-0.0%" ) & "</span> · R$ " & FORMAT ( [Preço Médio], "#,0" ) & "/un" )
			                & "</div></div></div>",
			        "",
			        CALCULATE ( MIN ( Dim_Produto[Ordem_Linha] ) ), ASC
			    )
			RETURN "<div class='vx pcs' style='height:76px'>" & _Card & "</div>"
		displayFolder: 91 HTML
		lineageTag: 99cb34e4-a942-58fc-8a82-a93a967205d0

	measure 'Insight Mix' =
			VAR _Tot = CALCULATE ( [Quantidade], ALLSELECTED ( Dim_Produto ) )
			VAR _TotF = CALCULATE ( [Faturamento], ALLSELECTED ( Dim_Produto ) )
			VAR _qP = DIVIDE ( CALCULATE ( [Quantidade], Dim_Produto[Linha] IN { "AGM", "EFB" } ), _Tot )
			VAR _fP = DIVIDE ( CALCULATE ( [Faturamento], Dim_Produto[Linha] IN { "AGM", "EFB" } ), _TotF )
			VAR _pS = CALCULATE ( [Preço Médio], Dim_Produto[Linha] = "SLI" )
			VAR _pA = CALCULATE ( [Preço Médio], Dim_Produto[Linha] = "AGM" )
			VAR _Frase =
			    "<b>AGM e EFB</b> (start-stop) são <b>" & FORMAT ( _qP, "0%" ) & "</b> do volume e <b>" & FORMAT ( _fP, "0%" )
			        & "</b> do faturamento. Uma AGM vale <b>" & FORMAT ( DIVIDE ( _pA, _pS ), "0.0" ) & "×</b> uma SLI (R$ "
			        & FORMAT ( _pA, "#,0" ) & " vs R$ " & FORMAT ( _pS, "#,0" ) & "): cada troca de SLI por AGM no mesmo cliente multiplica o faturamento da venda."
			RETURN
			    "<div class='vx ins' style='height:48px'><span class='dot'></span><div>" & _Frase & "</div>" & "<span class='src'>Fonte: base comercial VoltEx · corte em " & FORMAT ( [Data Corte], "dd/mm/yyyy" ) & "</span>" & "</div>"
		displayFolder: 91 HTML
		lineageTag: 02d41573-95a2-5385-a706-8e77b6699c34

	measure 'KPI Sucata' =
			VAR _Corte = [Data Corte]
			RETURN
			"<div class='vx kb ' style='height:78px'>" & "<div class='k'><div class='kl'>Sucata em aberto</div><div class='kv'>" & FORMAT ( [Sucata em Aberto kg] / 1000, "#,0.0" ) & "<small>t</small>" & "</div><div class='ks'>" & "posição em " & FORMAT ( _Corte, "dd/mm/yyyy" ) & "</div></div>" & "<div class='k'><div class='kl'>Lançamentos abertos</div><div class='kv'>" & FORMAT ( [Lançamentos em Aberto], "#,0" ) & "</div><div class='ks'>" & FORMAT ( [Clientes com Sucata], "#,0" ) & " clientes devendo casco" & "</div></div>" & "<div class='k'><div class='kl'>Atraso médio</div><div class='kv'>" & FORMAT ( [Atraso Médio Ponderado], "0" ) & "<small>dias</small>" & "</div><div class='ks'>" & "ponderado pelos kg em aberto" & "</div></div>" & "<div class='k'><div class='kl'>Acima de 60 dias</div><div class='kv'>" & "<span class='" & IF ( [% Sucata > 60 dias] > 0.3, "dn", "wa" ) & "'>" & FORMAT ( [% Sucata > 60 dias], "0%" ) & "</span>" & "</div><div class='ks'>" & FORMAT ( [Sucata > 60 dias kg] / 1000, "#,0.0" ) & " t paradas há mais de 60 dias" & "</div></div>" & "<div class='k'><div class='kl'>Troca de casco no ato</div><div class='kv'>" & FORMAT ( [% Vendas com Troca de Casco], "0.0%" ) & "</div><div class='ks'>" & FORMAT ( [Baterias sem Casco], "#,0" ) & " vendidas sem casco no período" & "</div></div>" & "</div>"
		displayFolder: 91 HTML
		lineageTag: 95e284fb-ada2-5a16-9584-a85ff5ce49d3

	measure 'Ranking Sucata HTML' =
			VAR _VendCtx =
			    CALCULATETABLE (
			        VALUES ( Dim_Vendedor[ID_Vendedor] ),
			        TREATAS ( VALUES ( Dim_Filial[ID_Filial] ), Dim_Vendedor[ID_Filial] )
			    )
			VAR _T =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            VALUES ( Dim_Cliente[Cliente_Rotulo] ),
			            "@kg", CALCULATE ( SUM ( Fato_Sucata[Sucata_Em_Aberto_KG] ) ),
			            "@d", CALCULATE ( MAX ( Fato_Sucata[Dias_Atraso] ) ),
			            "@n", CALCULATE ( COUNTROWS ( Fato_Sucata ) )
			        ),
			        TREATAS ( _VendCtx, Dim_Cliente[ID_Vendedor] )
			    )
			VAR _Top = TOPN ( 7, FILTER ( _T, [@kg] > 0 ), [@kg], DESC, Dim_Cliente[Cliente_Rotulo], ASC )
			VAR _Max = MAXX ( _Top, [@kg] )
			VAR _Rows =
			    CONCATENATEX (
			        _Top,
			        "<div class='rk'><div class='rn'>" & Dim_Cliente[Cliente_Rotulo] & "<span>" & [@n] & " lanç. · até " & [@d] & " dias</span></div>"
			            & "<div class='tr'><i style='width:" & FORMAT ( DIVIDE ( [@kg], _Max ) * 100, "0.0", "en-US" ) & "%;background:"
			            & IF ( [@d] > 90, "#E5484D", IF ( [@d] > 60, "#F2B84B", "#FF8C00" ) ) & "'></i></div>"
			            & "<b>" & FORMAT ( [@kg], "#,0" ) & " kg</b></div>",
			        "", [@kg], DESC, Dim_Cliente[Cliente_Rotulo], ASC
			    )
			RETURN
			    "<div class='vx'><div class='ov' style='color:#9AA6B0'>QUEM MAIS DEVE CASCO</div>"
			        & "<div class='ks' style='margin:2px 0 10px'>kg em aberto · barra vermelha = mais de 90 dias</div>"
			        & IF ( ISEMPTY ( _Top ), "<div class='ks'>Nenhuma sucata em aberto neste filtro.</div>", _Rows )
			        & "<div class='nt'>Fato_Sucata é a posição atual dos cascos devidos: não responde ao filtro de ano.</div></div>"
		displayFolder: 91 HTML
		lineageTag: c55788bf-3296-568e-8528-4a553033cff4

	measure 'Insight Sucata' =
			VAR _VendCtx =
			    CALCULATETABLE (
			        VALUES ( Dim_Vendedor[ID_Vendedor] ),
			        TREATAS ( VALUES ( Dim_Filial[ID_Filial] ), Dim_Vendedor[ID_Filial] )
			    )
			VAR _T =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( Dim_Municipio[Municipio] ), "@kg", CALCULATE ( SUM ( Fato_Sucata[Sucata_Em_Aberto_KG] ) ) ),
			        TREATAS ( _VendCtx, Dim_Cliente[ID_Vendedor] )
			    )
			VAR _Top = TOPN ( 1, _T, [@kg], DESC )
			VAR _Frase =
			    "<b>" & FORMAT ( [Sucata em Aberto kg] / 1000, "#,0.0" ) & " t</b> de sucata em aberto, <b>"
			        & FORMAT ( [% Sucata > 60 dias], "0%" ) & "</b> com mais de 60 dias. <b>" & MAXX ( _Top, Dim_Municipio[Municipio] )
			        & "</b> concentra " & FORMAT ( DIVIDE ( MAXX ( _Top, [@kg] ), SUMX ( _T, [@kg] ) ), "0%" )
			        & ". Para o EcoCiclo, cada bateria vendida sem casco no ato vira débito a cobrar: <b>"
			        & FORMAT ( 1 - [% Vendas com Troca de Casco], "0%" ) & "</b> das vendas do período."
			RETURN
			    "<div class='vx ins' style='height:48px'><span class='dot'></span><div>" & _Frase & "</div>" & "<span class='src'>Fonte: base comercial VoltEx · corte em " & FORMAT ( [Data Corte], "dd/mm/yyyy" ) & "</span>" & "</div>"
		displayFolder: 91 HTML
		lineageTag: c3013430-62b0-5077-8495-7c003fa11186

	measure 'TT Mes HTML' =
			VAR _mes = FORMAT ( MAX ( Dim_Calendario[Inicio_Mes] ), "mmmm/yyyy" )
			VAR _Tot = [Quantidade]
			VAR _v = [Var % Qtd AA]
			VAR _parc = SELECTEDVALUE ( Dim_Calendario[Status_Mes] ) = "Parcial"
			VAR _Bar = "<div class='tb'><span>"
			VAR _Lin =
			    CONCATENATEX (
			        VALUES ( Dim_Produto[Linha] ),
			        VAR _s = DIVIDE ( [Quantidade], _Tot )
			        RETURN _Bar & Dim_Produto[Linha] & "</span><div class='tr'><i style='width:" & FORMAT ( _s * 100, "0.0", "en-US" )
			            & "%'></i></div><b>" & FORMAT ( _s, "0%" ) & "</b></div>",
			        "", CALCULATE ( MIN ( Dim_Produto[Ordem_Linha] ) ), ASC
			    )
			RETURN
			    "<div class='vx tt2'><div class='ov'>" & UPPER ( _mes ) & IF ( _parc, " · PARCIAL", "" ) & "</div>"
			        & "<div class='kv' style='font-size:24px'>" & FORMAT ( _Tot, "#,0" ) & "<small>baterias</small></div>"
			        & "<div class='ks'>" & IF ( ISBLANK ( _v ), "sem base no ano anterior", "<span class='" & IF ( _v >= 0, "up", "dn" ) & "'>"
			            & IF ( _v >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _v ), "0.0%" ) & "</span> vs mesmo mês do ano anterior" ) & "</div>"
			        & "<div class='ov' style='color:#9AA6B0;margin-top:12px'>MIX POR LINHA</div>" & _Lin
			        & "<div class='tf'><div>Cobertura <b>" & FORMAT ( [% Cobertura], "0.0%" ) & "</b></div><div>Faturamento <b>"
			        & FORMAT ( [Faturamento] / 1000000, "#,0.00" ) & " mi</b></div><div>Linha Leve <b>" & FORMAT ( [% Linha Leve no Volume], "0%" ) & "</b></div></div></div>"
		displayFolder: 91 HTML
		lineageTag: 18ad9853-bdaf-5a92-a743-e329f2504c6d

	measure 'TT Vendedor HTML' =
			VAR _nm = SELECTEDVALUE ( Dim_Vendedor[Nome_Vendedor], "Vários vendedores" )
			VAR _ini = IF ( HASONEVALUE ( Dim_Vendedor[Nome_Vendedor] ), "V" & SUBSTITUTE ( _nm, "Vendedor ", "" ), "··" )
			VAR _rota = SELECTEDVALUE ( Dim_Vendedor[Area_Rota], "—" )
			VAR _fil = SELECTEDVALUE ( Dim_Vendedor[Filial_Vendedor], "—" )
			VAR _at = [% Atingimento Meta]
			VAR _td = [% Tendência Meta]
			VAR _w = MIN ( COALESCE ( _at, 0 ), 1.5 ) / 1.5 * 100
			RETURN
			    "<div class='vx tt2'><div style='display:flex;gap:12px;align-items:center'><div class='av'>" & _ini & "</div><div><div class='pn' style='font-size:15px'>"
			        & _nm & "</div><div class='ks'>" & _rota & " · " & _fil & "</div></div></div>"
			        & "<div class='tf' style='margin-top:12px'><div>Linha Leve<br><b>" & FORMAT ( [Qtd Linha Leve], "#,0" ) & "</b></div><div>Meta<br><b>"
			        & IF ( ISBLANK ( [Meta Linha Leve] ), "—", FORMAT ( [Meta Linha Leve], "#,0" ) ) & "</b></div><div>Cobertura<br><b>"
			        & FORMAT ( [% Cobertura], "0%" ) & "</b></div></div>"
			        & "<div class='ov' style='color:#9AA6B0;margin-top:12px'>ATINGIMENTO · TENDÊNCIA " & FORMAT ( _td, "0%" ) & "</div>"
			        & "<div class='tr' style='height:8px;margin-top:6px'><i style='width:" & FORMAT ( _w, "0.0", "en-US" ) & "%;background:"
			        & IF ( _at < 0.8, "#E5484D", "#FF8C00" ) & "'></i></div><div class='ks' style='margin-top:4px'>" & FORMAT ( _at, "0%" )
			        & " · carteira " & FORMAT ( [Carteira Ativa], "0" ) & " ativos · " & FORMAT ( [% Qtd Fora da UF], "0%" ) & " fora da UF da filial</div></div>"
		displayFolder: 91 HTML
		lineageTag: 2d70e32e-ecb1-5b8f-a67e-fd536a7ad633

	measure 'TT Produto HTML' =
			VAR _one = HASONEVALUE ( Dim_Produto[ID_Produto] )
			VAR _img = IF ( _one, SELECTEDVALUE ( Dim_Produto[Imagem_Base64] ), CALCULATE ( MAX ( Dim_Produto[Imagem_Linha] ) ) )
			VAR _nm =
			    IF ( _one, SELECTEDVALUE ( Dim_Produto[Produto] ),
			        IF ( HASONEVALUE ( Dim_Produto[Linha] ), "Linha " & SELECTEDVALUE ( Dim_Produto[Linha] ), "Vários produtos" ) )
			VAR _sub =
			    IF ( _one, SELECTEDVALUE ( Dim_Produto[Codigo_Original] ) & " · " & SELECTEDVALUE ( Dim_Produto[Familia] ),
			        CONCATENATEX ( VALUES ( Dim_Produto[Familia] ), Dim_Produto[Familia], ", " ) )
			VAR _v = [Var % Qtd AA]
			VAR _of =
			    CONCATENATEX (
			        VALUES ( Dim_Produto[ID_Produto_Oficial] ),
			        LOOKUPVALUE ( Dim_Catalogo[Produto_Oficial], Dim_Catalogo[ID_Produto_Oficial], Dim_Produto[ID_Produto_Oficial] ),
			        " · "
			    )
			RETURN
			    "<div class='vx tt2'><div style='display:flex;gap:12px;align-items:center'>"
			        & IF ( ISBLANK ( _img ), "", "<img class='timg' src='" & _img & "'/>" )
			        & "<div><div class='ov'>" & UPPER ( CONCATENATEX ( VALUES ( Dim_Produto[Linha] ), Dim_Produto[Linha], " · " ) ) & "</div><div class='pn' style='font-size:15px'>" & _nm & "</div>"
			        & "<div class='ks'>" & _sub & "</div></div></div>"
			        & "<div class='tf' style='margin-top:10px'><div>Quantidade<br><b>" & FORMAT ( [Quantidade], "#,0" ) & "</b></div><div>Faturamento<br><b>"
			        & FORMAT ( [Faturamento] / 1000000, "#,0.00" ) & " mi</b></div><div>Preço médio<br><b>R$ " & FORMAT ( [Preço Médio], "#,0" ) & "</b></div></div>"
			        & "<div class='tf'><div>vs AA<br><b class='" & IF ( _v < 0, "dn", "up" ) & "'>" & IF ( ISBLANK ( _v ), "—", FORMAT ( _v, "+0.0%;-0.0%" ) ) & "</b></div><div>Garantia<br><b>"
			        & FORMAT ( [% Garantia s/ Venda], "0.0%" ) & "</b></div><div>Sem casco<br><b>" & FORMAT ( 1 - [% Vendas com Troca de Casco], "0%" ) & "</b></div></div>"
			        & "<div class='nt' style='margin-top:8px'>Catálogo oficial: " & _of & "</div></div>"
		displayFolder: 91 HTML
		lineageTag: 1fcf1e81-39b2-5861-8896-4edc6f09a67f

	measure 'Capa HTML' =
			VAR _Fil = CONCATENATEX ( VALUES ( Dim_Filial[Filial_Curta] ), "<div>" & Dim_Filial[Filial_Curta] & "</div>", "", Dim_Filial[Filial_Curta], ASC )
			RETURN
			    "<div class='vx'><div class='cv-ov'>VOLTEX BATERIAS · PERFORMANCE COMERCIAL</div>"
			        & "<div class='cv-t'>Vendas, carteira<br>e mercado em <span>um só fluxo</span></div>"
			        & "<div class='cv-s'>Metas da Linha Leve, cobertura de carteira, share sobre o potencial de cada praça, SWOT de clientes e sucata do EcoCiclo. "
			        & FORMAT ( [Itens de Nota], "#,0" ) & " itens de nota até " & FORMAT ( [Data Corte], "dd/mm/yyyy" ) & ".</div>"
			        & "<div class='cv-l'>" & _Fil & "<div>" & FORMAT ( [Carteira Ativa], "0" ) & " clientes ativos</div><div>"
			        & COUNTROWS ( Dim_Municipio ) & " praças</div></div></div>"
		displayFolder: 91 HTML
		lineageTag: 94835189-a0f5-55ea-8f4c-f7b489d5dc2d

	measure 'Qtd Linha Leve' = CALCULATE ( [Quantidade], KEEPFILTERS ( Dim_Produto[Familia] = "Linha Leve" ) )
		formatString: #,0
		displayFolder: 02 Metas
		lineageTag: 4e6c665d-d533-5996-b4fc-366dae378858

	measure '% Linha Leve no Volume' = DIVIDE ( [Qtd Linha Leve], [Quantidade] )
		formatString: 0.0%
		displayFolder: 02 Metas
		lineageTag: 7d26e4eb-f7e5-5063-99e2-dcbf6ed1a42d

	measure 'Meta Linha Leve' =
			-- Meta mora no grão vendedor × mês, só para a Linha Leve (40–72Ah).
			-- Fica em branco com filtro fora desse grão (produto, cliente, município) ou abaixo do mês.
			VAR _ForaDoGrao =
			    ISFILTERED ( Dim_Produto ) || ISFILTERED ( Dim_Cliente ) || ISFILTERED ( Dim_Municipio )
			VAR _AbaixoDoMes = ISINSCOPE ( Dim_Calendario[Data] )
			VAR _Meses = VALUES ( Dim_Calendario[Inicio_Mes] )
			VAR _VendCtx =
			    CALCULATETABLE (
			        VALUES ( Dim_Vendedor[ID_Vendedor] ),
			        TREATAS ( VALUES ( Dim_Filial[ID_Filial] ), Dim_Vendedor[ID_Filial] )
			    )
			RETURN
			    IF (
			        NOT _ForaDoGrao && NOT _AbaixoDoMes,
			        CALCULATE (
			            SUM ( Fato_Metas[Meta_Quantidade] ),
			            REMOVEFILTERS ( Dim_Calendario ),
			            TREATAS ( _Meses, Fato_Metas[Data_Mes] ),
			            TREATAS ( _VendCtx, Fato_Metas[ID_Vendedor] )
			        )
			    )
		formatString: #,0
		displayFolder: 02 Metas
		lineageTag: c06a2925-a512-5e17-935b-1621ddd0e2b9

	measure '% Atingimento Meta' = DIVIDE ( [Qtd Linha Leve], [Meta Linha Leve] )
		formatString: 0.0%
		displayFolder: 02 Metas
		lineageTag: 303b38c7-0af8-5812-8f64-c9407451d74a

	measure 'Gap Meta' =
			VAR _g = [Meta Linha Leve] - [Qtd Linha Leve]
			RETURN IF ( NOT ISBLANK ( [Meta Linha Leve] ), MAX ( _g, 0 ) )
		formatString: #,0
		displayFolder: 02 Metas
		lineageTag: f0219cc7-cd61-5232-92b0-dc19be0faf95

	measure 'Projeção Linha Leve' =
			-- Realizado + extrapolação linear do mês corrente (parcial) até o fim do mês
			VAR _Corte = [Data Corte]
			VAR _IniMes = DATE ( YEAR ( _Corte ), MONTH ( _Corte ), 1 )
			VAR _Fator = DIVIDE ( DAY ( EOMONTH ( _Corte, 0 ) ), DAY ( _Corte ) ) - 1
			VAR _MesAtual =
			    CALCULATE ( [Qtd Linha Leve], KEEPFILTERS ( Dim_Calendario[Inicio_Mes] = _IniMes ) )
			RETURN
			    IF ( NOT ISBLANK ( [Qtd Linha Leve] ), [Qtd Linha Leve] + COALESCE ( _MesAtual, 0 ) * _Fator )
		formatString: #,0
		displayFolder: 02 Metas
		lineageTag: dcb06637-d736-5fa5-be69-b97db46e6815

	measure '% Tendência Meta' = DIVIDE ( [Projeção Linha Leve], [Meta Linha Leve] )
		formatString: 0.0%
		displayFolder: 02 Metas
		lineageTag: b40bc90d-45d9-585c-9af2-33db90f9da32

	column Coluna
		dataType: string
		isHidden
		lineageTag: 08fe6b92-715a-5960-b3ce-a42d3daf6cf8
		summarizeBy: none
		sourceColumn: Coluna

		annotation SummarizationSetBy = Automatic

	partition _Medidas = m
		mode: import
		source =
				let
				    Resultado = #table ( type table [Coluna = text], {} )
				in
				    Resultado

	annotation PBI_ResultType = Table

